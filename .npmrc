# better-sqlite3 v13 ships prebuilt native binaries for every supported
# platform inside its npm tarball, so it needs no compiler. It opts out of
# npm's automatic node-gyp build with "gypfile": false, but npm loses that
# field when it builds the tree from package-lock.json and runs
# "node-gyp rebuild" anyway -- which fails on machines without a C++
# toolchain (e.g. Windows without Visual Studio Build Tools).
#
# No dependency in this project needs an install lifecycle script, so
# disabling them keeps "npm install" and "npm ci" working everywhere.
ignore-scripts=true
